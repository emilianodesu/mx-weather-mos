# Local PostgreSQL + PostGIS configuration (do NOT commit real production secrets)
POSTGRES_DB=mxweather
POSTGRES_USER=mxweather
POSTGRES_PASSWORD=mxweather_local_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://mxweather:mxweather_local_dev@postgres:5432/mxweather

# Runtime storage paths (mounted inside Docker volumes)
MXWEATHER_DATA_DIR=/app/data
MXWEATHER_ARTIFACTS_DIR=/app/artifacts

# Upstream API configuration
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_HISTORICAL_FORECAST_URL=https://historical-forecast-api.open-meteo.com/v1/forecast
OPEN_METEO_LIVE_FORECAST_URL=https://api.open-meteo.com/v1/forecast
CONAGUA_SMN_URL=https://smn.conagua.gob.mx/webservices/?method=1
CONAGUA_SMN_TIMEOUT_SECONDS=15

# API & Frontend
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=/api
